<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_atur_form" model="ir.ui.view">
        <field name="name">karisma.telegram.atur.form</field>
        <field name="model">karisma.telegram.atur</field>
        <field name="arch" type="xml">
            <form string="Bot Telegram">
                <header>
                    <button name="action_sambungkan" type="object" string="Sambungkan" class="btn-primary"/>
                    <button name="action_kirim_sekarang" type="object" string="Kirim ringkasan sekarang"/>
                    <button name="action_putuskan" type="object" string="Putuskan bot"
                            confirm="Token dihapus dan bot berhenti membalas. Lanjut?"/>
                </header>
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="oe_title"><h1>Laporan pabrik lewat Telegram</h1></div>
                    <div class="alert alert-info" role="alert">
                        <b>Cara menyambungkan:</b>
                        1. Di Telegram, buka @BotFather dan kirim /newbot sampai mendapat token.
                        2. Tempel token di kotak <b>Token bot</b> di bawah.
                        3. Klik tombol <b>Sambungkan</b> di kiri atas.
                        4. Dari HP, kirim /start ke bot (atau masukkan bot ke grup).
                        5. Buka menu <b>Penerima</b> dan klik <b>Setujui</b> pada chat itu. Hanya chat yang disetujui yang menerima
                        laporan. Ringkasan pagi dikirim Senin sampai Sabtu pukul 06.30 WIB.
                    </div>
                    <group>
                        <group string="Token">
                            <field name="token" password="True" class="o_field_highlight border rounded px-2"
                                   placeholder="Tempel token dari @BotFather di sini"/>
                        </group>
                        <group string="Status">
                            <field name="nama_bot"/>
                            <field name="status"/>
                            <field name="jumlah_penerima"/>
                            <field name="alamat_webhook"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_atur" model="ir.actions.act_window">
        <field name="name">Bot Telegram</field>
        <field name="res_model">karisma.telegram.atur</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="view_telegram_chat_list" model="ir.ui.view">
        <field name="name">karisma.telegram.chat.list</field>
        <field name="model">karisma.telegram.chat</field>
        <field name="arch" type="xml">
            <list string="Penerima" editable="bottom" create="0" decoration-muted="not disetujui">
                <header>
                    <button name="action_setujui" type="object" string="Setujui yang dipilih"/>
                </header>
                <field name="disetujui" widget="boolean_toggle"/>
                <button name="action_setujui" type="object" string="Setujui" icon="fa-check" invisible="disetujui"/>
                <field name="name"/>
                <field name="jenis"/>
                <field name="username"/>
                <field name="chat_id"/>
                <field name="aktif_pagi"/>
                <field name="tanggal_daftar"/>
                <field name="terakhir"/>
                <field name="jumlah_perintah"/>
                <field name="galat_terakhir" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_telegram_chat" model="ir.actions.act_window">
        <field name="name">Penerima Telegram</field>
        <field name="res_model">karisma.telegram.chat</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_telegram_root" name="Bot Telegram" parent="base.menu_administration" sequence="90"/>
    <menuitem id="menu_telegram_atur" name="Sambungkan bot" parent="menu_telegram_root" action="action_telegram_atur" sequence="1"/>
    <menuitem id="menu_telegram_chat" name="Penerima" parent="menu_telegram_root" action="action_telegram_chat" sequence="2"/>
</odoo>
