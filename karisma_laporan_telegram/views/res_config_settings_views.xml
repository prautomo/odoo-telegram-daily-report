<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pintasan di Pengaturan Umum, karena menu atas aplikasi Pengaturan mudah terlewat. -->
    <record id="res_config_settings_view_form_telegram" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.karisma.telegram</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="karisma_telegram">
                    <block title="Bot Telegram" name="karisma_telegram_container">
                        <setting id="karisma_telegram_setting" string="Laporan pabrik lewat Telegram"
                                 help="Ringkasan pagi dan perintah /stok, /lembur, /piutang ke HP pimpinan">
                            <div class="mt8">
                                <button name="%(karisma_laporan_telegram.action_telegram_atur)d" icon="east" type="action"
                                        string="Isi token dan sambungkan bot" class="btn-link"/>
                            </div>
                            <div class="mt8">
                                <button name="%(karisma_laporan_telegram.action_telegram_chat)d" icon="east" type="action"
                                        string="Daftar penerima" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
